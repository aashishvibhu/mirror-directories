<UserControl
    x:Class="DriveSync.App.Views.HealthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Margin="36,16,36,36">

            <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding LoadError}" />
            </Border>

            <!--  Where things stand  -->
            <Border Padding="24,20" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,18,0" VerticalAlignment="Top" FontSize="30">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Warning24" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                        <Setter Property="Symbol" Value="ShieldCheckmark24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Headline}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Secondary}" Text="{Binding QuickLine}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="{Binding FullLine}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Command="{Binding CheckNowCommand}" Content="Check everything now"
                                   Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                   ToolTip="Reads every file on the backup drive and compares its checksum. This can take a while." />
                        <ui:Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Command="{Binding RepairCommand}" Content="Repair" Icon="{ui:SymbolIcon Wrench24}"
                                   ToolTip="Recopies damaged or missing copies from this PC, where the original hasn't changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  A check in progress  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Panel}" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="16" Style="{StaticResource Strong}" Text="{Binding Phase}" />
                        <ui:Button Grid.Column="1" Command="{Binding CancelCommand}" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" />
                    </Grid>
                    <ProgressBar Height="4" Margin="0,12,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}" Text="{Binding Detail}" />
                </StackPanel>
            </Border>

            <!--  Result of the last check  -->
            <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="8" Visibility="{Binding ResultMessage, Converter={StaticResource EmptyToCollapsed}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ResultMessage}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding ExtraLine}"
                                   Visibility="{Binding ExtraLine, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Top" Appearance="Transparent" AutomationProperties.Name="Dismiss"
                               Command="{Binding DismissResultCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
                </Grid>
            </Border>

            <!--  Copies with a problem  -->
            <Border Margin="0,12,0,0" Padding="0" Style="{StaticResource Panel}" Visibility="{Binding Issues.Count, Converter={StaticResource CountToVisibility}}">
                <StackPanel>
                    <TextBlock Margin="20,16,20,10" FontSize="16" Style="{StaticResource Strong}" Text="Backup copies with a problem" />
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HealthIssueRow}">
                                <Border Padding="20,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                Style="{StaticResource Pill}">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Problem}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Key}" ToolTip="{Binding Key}" />
                                            <TextBlock Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding Note}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  The rolling check  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="16" Style="{StaticResource Strong}" Text="Checked a little after every sync" />
                        <ui:ToggleSwitch Grid.Column="1" AutomationProperties.Name="Check older copies after each sync" IsChecked="{Binding RollingCheck}" OffContent="Off"
                                         OnContent="On" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Secondary}" Text="{Binding RollingCheckNote}" />
                    <ProgressBar Height="4" Margin="0,14,0,0" Maximum="100" Value="{Binding VerifiedPercent, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding VerifiedLine}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
