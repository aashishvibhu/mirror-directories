<ui:FluentWindow
    x:Class="DriveSync.App.Views.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    Title="Set up DriveSync"
    Width="1000"
    Height="720"
    MinWidth="860"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Set up DriveSync" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="HardDrive20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Steps  -->
            <StackPanel Margin="28,20,16,0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Welcome" />
                <TextBlock Margin="0,6,0,24" Style="{StaticResource Secondary}" Text="Four quick steps, then your first backup." />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WizardStep}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Circle" Width="28" Height="28" BorderThickness="1" CornerRadius="14"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                    <TextBlock x:Name="Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Number}" />
                                </Border>
                                <TextBlock x:Name="Label" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Title}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static vm:StepStateConverter.IsCurrent}">
                                            <Binding Path="Number" />
                                            <Binding Path="DataContext.Step" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static vm:StepStateConverter.IsDone}">
                                            <Binding Path="Number" />
                                            <Binding Path="DataContext.Step" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Number" Property="Text" Value="✓" />
                                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Pages  -->
            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <ScrollViewer Padding="36,28,36,24" VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="720" HorizontalAlignment="Left">

                        <!--  Step 1: folders  -->
                        <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Which folders should DriveSync back up?" />
                            <TextBlock Margin="0,8,0,20" Style="{StaticResource Secondary}" Text="Tick each folder you want backed up. Nothing is selected for you." />
                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FolderChoiceViewModel}">
                                        <Border Margin="0,0,0,8" Padding="16,12" Style="{StaticResource Panel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                                <ui:SymbolIcon Grid.Column="1" Margin="4,0,14,0" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Folder24" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Strong}" Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Path}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SizeText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <ui:Button Command="{Binding AddFolderCommand}" Content="Add another folder…" Icon="{ui:SymbolIcon FolderAdd24}" />
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding SelectionSummary}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Step 2: drive  -->
                        <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Where should backups go?" />
                            <TextBlock Margin="0,8,0,20" Style="{StaticResource Secondary}"
                                       Text="Pick your backup drive. DriveSync keeps everything in a DriveSyncBackup folder on it, as plain files you can open without DriveSync." />
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriveChoiceViewModel}">
                                        <RadioButton AutomationProperties.Name="{Binding Title}" GroupName="drive" IsChecked="{Binding IsSelected}" Style="{StaticResource ChoiceCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Margin="0,0,14,0" VerticalAlignment="Top" FontSize="26" Symbol="HardDrive20" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource Strong}" Text="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Kind}" />
                                                    <ProgressBar Width="260" Height="4" Margin="0,10,0,6" HorizontalAlignment="Left" Value="{Binding UsedPercent, Mode=OneWay}"
                                                                 Visibility="{Binding SpaceText, Converter={StaticResource EmptyToCollapsed}}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SpaceText}" Visibility="{Binding SpaceText, Converter={StaticResource EmptyToCollapsed}}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" Style="{StaticResource Pill}"
                                                        Visibility="{Binding HasExistingBackup, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Has a DriveSync backup" />
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <ui:Button Command="{Binding RefreshDrivesCommand}" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                <ui:Button Margin="8,0,0,0" Command="{Binding ChooseDriveFolderCommand}" Content="Use a folder instead…" Icon="{ui:SymbolIcon FolderOpen24}" />
                            </StackPanel>
                            <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{Binding DriveWarning, Converter={StaticResource EmptyToCollapsed}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Top" FontSize="20" Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Warning24" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding DriveWarning}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!--  Step 3: missing files  -->
                        <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource StepTitle}" Text="When a backed-up file disappears from this PC…" />
                            <TextBlock Margin="0,8,0,20" Style="{StaticResource Secondary}"
                                       Text="This is for files you delete or move away yourself. Files you offload or delete through DriveSync are always handled exactly as you asked." />
                            <ItemsControl ItemsSource="{Binding Policies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PolicyChoiceViewModel}">
                                        <RadioButton AutomationProperties.Name="{Binding Title}" GroupName="policy" IsChecked="{Binding IsSelected}" Style="{StaticResource ChoiceCard}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Strong}" Text="{Binding Title}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding Description}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="You can change this later." />
                        </StackPanel>

                        <!--  Step 4: summary  -->
                        <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource StepTitle}" Text="Ready for your first backup" />
                            <TextBlock Margin="0,8,0,20" Style="{StaticResource Secondary}" Text="Check the details, then start. You can keep using your PC while it runs." />
                            <Border Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource Secondary}" Text="Folders" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" Style="{StaticResource Body}" Text="{Binding SummaryFolders}" />
                                    <TextBlock Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource Secondary}" Text="Backup goes to" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" Style="{StaticResource Body}" Text="{Binding SummaryDrive}" />
                                    <TextBlock Grid.Row="2" Margin="0,0,0,14" Style="{StaticResource Secondary}" Text="Missing files" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" Style="{StaticResource Body}" Text="{Binding SummaryPolicy}" />
                                    <TextBlock Grid.Row="3" Margin="0,0,0,14" Style="{StaticResource Secondary}" Text="Size" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,14" Style="{StaticResource Body}" Text="{Binding SummarySize}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource Secondary}" Text="Time" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Body}" Text="{Binding SummaryTime}" />
                                </Grid>
                            </Border>
                            <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Top" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ShieldCheckmark24" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Body}"
                                               Text="DriveSync only copies your files to the drive. It never deletes anything: whatever it removes later, on the PC or the drive, goes to the Recycle Bin." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Footer  -->
        <Border Grid.Row="2" Padding="28,14" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Style="{StaticResource Body}" Text="{Binding Error}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ProgressRing Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button MinWidth="96" Command="{Binding BackCommand}" Content="Back" />
                    <ui:Button MinWidth="96" Margin="8,0,0,0" Appearance="Primary" Command="{Binding NextCommand}" Content="Next"
                               Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding FinishCommand}" Content="Start first backup" Icon="{ui:SymbolIcon ArrowSync24}"
                               Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
