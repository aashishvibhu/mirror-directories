<UserControl
    x:Class="DriveSync.App.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Margin="36,28,36,36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Your backups" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Secondary}" Text="{Binding Headline}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <ui:Button Command="{Binding Main.AddBackupCommand}" Content="Add backup" Icon="{ui:SymbolIcon Add24}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding Main.SyncAllCommand}" Content="Sync all connected" Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="Back up every backup whose drive is plugged in, one after another" />
                </StackPanel>
            </Grid>

            <!--  No backups at all  -->
            <Border Margin="0,24,0,0" Padding="28,24" Style="{StaticResource Panel}" Visibility="{Binding Main.Backups.Count, Converter={StaticResource ZeroToVisible}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="HardDrive20" />
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="No backups yet" />
                    <TextBlock Margin="0,6,0,16" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="Pick some folders and a drive, and DriveSync keeps a copy up to date." />
                    <ui:Button HorizontalAlignment="Center" Appearance="Primary" Command="{Binding Main.AddBackupCommand}" Content="Add a backup" Icon="{ui:SymbolIcon Add24}" />
                </StackPanel>
            </Border>

            <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Main.Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BackupPageViewModel}">
                        <Border Margin="0,0,0,12" Style="{StaticResource Panel}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" Margin="0,0,18,0" VerticalAlignment="Center" CornerRadius="24">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.Status}" Value="{x:Static vm:BackupStatus.NeedsAttention}">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Dashboard.Status}" Value="{x:Static vm:BackupStatus.NeverBackedUp}">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Dashboard.Status}" Value="{x:Static vm:BackupStatus.DriveMissing}">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon FontSize="24" Symbol="{Binding Dashboard.StatusIcon}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                                <Hyperlink Command="{Binding OpenCommand}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextDecorations="None">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Route}" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Dashboard.Status}" Value="{x:Static vm:BackupStatus.DriveMissing}">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Dashboard.Status}" Value="{x:Static vm:BackupStatus.NeverBackedUp}">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Dashboard.StatusTitle}" />
                                            </Border>
                                            <Border Margin="0,0,8,0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Style="{StaticResource Pill}"
                                                    Visibility="{Binding PendingCount, Converter={StaticResource CountToVisibility}}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PendingCount, StringFormat={}{0:N0} need a decision}" />
                                            </Border>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Dashboard.StatusDetail}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:Button Command="{Binding OpenMissingCommand}" Content="Review" Visibility="{Binding PendingCount, Converter={StaticResource CountToVisibility}}" />
                                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding SyncNowCommand}" Content="Sync now"
                                                   Visibility="{Binding Dashboard.IsSyncing, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ui:Button Margin="8,0,0,0" Command="{Binding Dashboard.PauseOrResumeCommand}" Icon="{ui:SymbolIcon Pause24}" Content="Pause"
                                                   Visibility="{Binding Dashboard.IsSyncing, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="66,14,0,0" Visibility="{Binding Dashboard.IsSyncing, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Height="4" IsIndeterminate="{Binding Dashboard.IsProgressIndeterminate}" Maximum="100" Value="{Binding Dashboard.SyncPercent, Mode=OneWay}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}">
                                        <Run Text="{Binding Dashboard.SyncPhase, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Dashboard.SyncDetail, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap"
                       Text="Sync all connected backs up each backup whose drive is plugged in, one after another, without the review step. You can open any backup while another one syncs." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
