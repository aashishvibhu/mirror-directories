<ui:FluentWindow
    x:Class="DriveSync.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DriveSync.App.Views"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    Title="DriveSync"
    Width="1180"
    Height="800"
    MinWidth="920"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <views:PreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MissingFilesViewModel}">
            <views:MissingFilesView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DriveSync">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="HardDrive20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="8,4,8,12">
                <Border
                    Margin="6,0,6,0"
                    Padding="12,8"
                    CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    DockPanel.Dock="Bottom"
                    Visibility="{Binding UsesStandInRecycleBin, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="Demo mode: a test folder stands in for the Recycle Bin." />
                </Border>

                <ListBox
                    AutomationProperties.Name="Navigation"
                    DockPanel.Dock="Top"
                    SelectedIndex="{Binding NavIndex, Mode=TwoWay}"
                    Style="{StaticResource NavList}">
                    <ListBoxItem AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="20" Symbol="Home24" />
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" Text="Home" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Missing files">
                        <Grid Width="180">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="20" Symbol="DocumentQuestionMark24" />
                                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" Text="Missing files" />
                            </StackPanel>
                            <Border
                                HorizontalAlignment="Right"
                                Background="{DynamicResource SystemFillColorCautionBrush}"
                                Style="{StaticResource Pill}"
                                Visibility="{Binding PendingCount, Converter={StaticResource CountToVisibility}}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding PendingCount, StringFormat={}{0:N0}}" />
                            </Border>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
                <Grid />
            </DockPanel>

            <Border
                Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
