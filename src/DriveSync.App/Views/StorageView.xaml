<UserControl
    x:Class="DriveSync.App.Views.StorageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DriveSync.App.Views"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <StackPanel MaxWidth="1040" Margin="36,16,36,36">

                <Border Padding="16,12" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Style="{StaticResource Body}" Text="{Binding LoadError}" />
                </Border>

                <!--  Result of the last action  -->
                <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="8" Visibility="{Binding ResultMessage, Converter={StaticResource EmptyToCollapsed}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding ResultMessage}" />
                            <ItemsControl ItemsSource="{Binding ResultProblems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Top" Appearance="Transparent" AutomationProperties.Name="Dismiss"
                                   Command="{Binding DismissResultCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
                    </Grid>
                </Border>

                <!--  What takes the space  -->
                <Border Style="{StaticResource Panel}" Visibility="{Binding Bar, Converter={StaticResource EmptyToCollapsed}}">
                    <StackPanel>
                        <TextBlock FontSize="16" Style="{StaticResource Strong}" Text="What's on the backup drive" />
                        <views:StorageBarView Margin="0,14,0,0" DataContext="{Binding Bar}" />
                    </StackPanel>
                </Border>

                <!--  Old versions  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" Style="{StaticResource Strong}" Text="Old versions" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding VersionsSummary}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Top" Appearance="Transparent" Command="{Binding OpenVersionsFolderCommand}" Content="Open folder"
                                       Icon="{ui:SymbolIcon FolderOpen24}" />
                        </Grid>
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Hogs}" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VersionHogRow}">
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Key}" ToolTip="{Binding Key}" />
                                        <TextBlock Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Secondary}" Text="Suggest a clean-up. You see exactly what would go before anything does." />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button Margin="0,0,8,6" Command="{Binding SuggestThinOutCommand}" Content="Thin out…"
                                           ToolTip="Keep everything for 30 days, then one a week, then one a month" />
                                <ui:Button Margin="0,0,8,6" Command="{Binding SuggestKeepNewestCommand}" Content="Keep the newest 5 of each file…" />
                                <ui:Button Margin="0,0,8,6" Command="{Binding SuggestOlderThanYearCommand}" Content="Remove those older than a year…" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Removed files  -->
                <Border Margin="0,12,0,0" Padding="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Margin="20,16,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" Style="{StaticResource Strong}" Text="Removed from this backup" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding RemovedSummary}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding RemovedPlaceNote}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                <ui:Button HorizontalAlignment="Stretch" Command="{Binding OpenTrashFolderCommand}" Content="Open trash folder" Icon="{ui:SymbolIcon FolderOpen24}" />
                                <ui:Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Command="{Binding OpenRecycleBinCommand}" Content="Open Recycle Bin"
                                           Icon="{ui:SymbolIcon Delete24}" />
                            </StackPanel>
                        </Grid>
                        <Border Padding="20,8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                Visibility="{Binding SelectedCount, Converter={StaticResource CountToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Strong}" Text="{Binding SelectedCount, StringFormat={}{0:N0} selected}" />
                                <ui:Button Grid.Column="1" Appearance="Primary" Command="{Binding RestoreSelectedCommand}" Content="Restore" Icon="{ui:SymbolIcon ArrowDownload24}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Removed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RemovedRowViewModel}">
                                    <Border Padding="20,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Name}" ToolTip="{Binding Key}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Margin="12,0" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" Style="{StaticResource Pill}">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Where}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SizeText}" TextAlignment="Right" />
                                            <ui:Button Grid.Column="4" Margin="12,0,0,0" Command="{Binding RestoreCommand}" Content="Restore" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ui:ProgressRing Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!--  A clean-up is only ever a suggestion until this is confirmed  -->
        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="500" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ConfirmTitle}" />
                    <TextBlock Margin="0,12,0,24" Style="{StaticResource Body}" Text="{Binding ConfirmMessage}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button MinWidth="96" Command="{Binding ConfirmNoCommand}" Content="Cancel" IsCancel="True" />
                        <ui:Button Margin="8,0,0,0" Appearance="Danger" Command="{Binding ConfirmYesCommand}" Content="Remove these versions" Icon="{ui:SymbolIcon Delete24}"
                                   Visibility="{Binding ConfirmHasAction, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
