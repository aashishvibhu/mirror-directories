<UserControl
    x:Class="DriveSync.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Margin="36,28,36,36">
            <TextBlock Style="{StaticResource PageTitle}" Text="Home" />

            <!--  Status  -->
            <Border Margin="0,20,0,0" Padding="24,20" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BackupStatus.UpToDate}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BackupStatus.NeedsAttention}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BackupStatus.NeverBackedUp}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <ui:SymbolIcon FontSize="28" Symbol="{Binding StatusIcon}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BackupStatus.UpToDate}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BackupStatus.NeedsAttention}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BackupStatus.NeverBackedUp}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding StatusTitle}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding StatusDetail}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Padding="22,10" VerticalAlignment="Center" Appearance="Primary" Command="{Binding SyncNowCommand}"
                               Content="Sync now" FontSize="15" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Check for changes, review them, then back up" />
                </Grid>
            </Border>

            <!--  Live progress  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Panel}" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="16" Style="{StaticResource Strong}" Text="{Binding SyncPhase}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Command="{Binding PauseOrResumeCommand}" Icon="{ui:SymbolIcon Pause24}" Content="Pause"
                                       Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:Button Command="{Binding PauseOrResumeCommand}" Icon="{ui:SymbolIcon Play24}" Content="Resume"
                                       Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding CancelSyncCommand}" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,6,0,12" Style="{StaticResource Caption}" Text="{Binding SyncItem}" />
                    <ProgressBar Height="4" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Value="{Binding SyncPercent, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}" Text="{Binding SyncDetail}" />
                </StackPanel>
            </Border>

            <!--  Files waiting for a decision  -->
            <Border Margin="0,12,0,0" Padding="20,14" CornerRadius="8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding PendingCount, Converter={StaticResource CountToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,14,0" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="DocumentQuestionMark24" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Strong}" Text="{Binding PendingHeadline}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="{Binding PendingDetail}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding ReviewMissingCommand}" Content="Review" />
                </Grid>
            </Border>

            <!--  Result of the last sync  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Panel}" Visibility="{Binding LastRunMessage, Converter={StaticResource EmptyToCollapsed}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Margin="0,0,14,0" VerticalAlignment="Top" FontSize="22">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Checkmark24" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastRunNeedsAttention}" Value="True">
                                        <Setter Property="Symbol" Value="Warning24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding LastRunMessage}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding LastRunProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Totals  -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="ShieldCheckmark24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Secondary}" Text="Protected" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Metric}" Text="{Binding ProtectedCount}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProtectedSize}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Archive24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Secondary}" Text="Offloaded" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Metric}" Text="{Binding OffloadedCount}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding OffloadedSize}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="DocumentQuestionMark24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Secondary}" Text="Need a decision" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Metric}" Text="{Binding PendingCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource Caption}" Text="missing from this PC" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Panel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Secondary}" Text="Problems" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Metric}" Text="{Binding ProblemsCount}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ProblemsNote}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Recent activity  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock FontSize="16" Style="{StaticResource Strong}" Text="Recent activity" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}" Text="Nothing yet. Your first sync will show up here."
                               Visibility="{Binding Activity.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Strong}" FontWeight="Normal" Text="{Binding What}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,16,0" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Item}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding When}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
