<UserControl
    x:Class="DriveSync.App.Views.MissingFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MissingFilesViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ui:SymbolIcon x:Key="DeleteIcon" x:Shared="False" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="Delete24" />
        <ui:SymbolIcon x:Key="KeepIcon" x:Shared="False" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Archive24" />
        <ui:SymbolIcon x:Key="LaterIcon" x:Shared="False" Symbol="Clock24" />
    </UserControl.Resources>

    <Grid>
        <Grid Margin="36,24,36,24" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Missing files" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Secondary}" Text="{Binding Headline}" />
            </StackPanel>

            <!--  What each answer means, always visible  -->
            <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="Delete24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Strong}" Text="Deleted on purpose" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Also removed from the backup: the copy goes to the backup drive's Recycle Bin." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Archive24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Strong}" Text="Keep on backup" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="You removed it to free space. It stays on the backup, marked as offloaded." />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="18" Symbol="Clock24" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Strong}" Text="Decide later" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Nothing changes. It stays on the backup and waits here." />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Result of the last decision  -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="8" Visibility="{Binding ResultMessage, Converter={StaticResource EmptyToCollapsed}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ResultMessage}" />
                        <ItemsControl ItemsSource="{Binding ResultProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Top" Appearance="Transparent" AutomationProperties.Name="Dismiss"
                               Command="{Binding DismissResultCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
                </Grid>
            </Border>

            <!--  Search, then actions for the ticked files  -->
            <StackPanel Grid.Row="3" Margin="0,16,0,12" Visibility="{Binding TotalCount, Converter={StaticResource CountToVisibility}}">
                <ui:TextBox Width="340" HorizontalAlignment="Left" AutomationProperties.Name="Search missing files" Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Search missing files" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Border Margin="0,12,0,0" Padding="16,8" CornerRadius="8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding SelectedCount, Converter={StaticResource CountToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Strong}" Text="{Binding SelectedCount, StringFormat={}{0:N0} selected}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Command="{Binding DeleteSelectedCommand}" Content="Deleted on purpose" Icon="{StaticResource DeleteIcon}" />
                            <ui:Button Margin="6,0,0,0" Command="{Binding KeepSelectedCommand}" Content="Keep on backup" Icon="{StaticResource KeepIcon}" />
                            <ui:Button Margin="6,0,0,0" Appearance="Transparent" Command="{Binding LaterSelectedCommand}" Content="Decide later" />
                            <ui:Button Margin="6,0,0,0" Appearance="Transparent" Command="{Binding ClearSelectionCommand}" Content="Clear selection" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  Loading, errors and the all-clear  -->
            <ui:ProgressRing Grid.Row="4" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <Border Grid.Row="4" Margin="0,16,0,0" Padding="16,12" VerticalAlignment="Top" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding LoadError}" />
            </Border>
            <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="56" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="Checkmark24" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Nothing is waiting for a decision" />
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="When a backed-up file disappears from this PC, it shows up here." />
            </StackPanel>

            <!--  Groups  -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MissingGroupViewModel}">
                            <Border Margin="0,0,0,10" Padding="0" Style="{StaticResource Panel}">
                                <StackPanel>
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Margin="0,0,14,0" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Folder24" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Strong}" Text="{Binding Folder}" ToolTip="{Binding Folder}" />
                                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                                <Border Margin="10,0,0,0" Style="{StaticResource RecyclePill}" Visibility="{Binding InRecycleBinCount, Converter={StaticResource CountToVisibility}}"
                                                        ToolTip="Found in this PC's Recycle Bin, which suggests they were deleted on purpose.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon FontSize="12" Symbol="Recycle20" />
                                                        <TextBlock Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding RecycleText}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button Command="{Binding DeleteAllCommand}" Content="Deleted on purpose" Icon="{StaticResource DeleteIcon}" />
                                            <ui:Button Margin="6,0,0,0" Command="{Binding KeepAllCommand}" Content="Keep on backup" Icon="{StaticResource KeepIcon}" />
                                            <ui:Button Margin="6,0,0,0" Appearance="Transparent" Command="{Binding LaterAllCommand}" Content="Decide later" />
                                            <ui:Button Width="36" Height="32" Margin="6,0,0,0" Padding="0" Appearance="Transparent" AutomationProperties.Name="Show files"
                                                       Command="{Binding ToggleExpandedCommand}" ToolTip="Show or hide the files">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Icon" Value="{ui:SymbolIcon ChevronDown24}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Icon" Value="{ui:SymbolIcon ChevronUp24}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding VisibleFiles}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MissingFileViewModel}">
                                                <Border Padding="16,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Margin="22,0,4,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Name}" ToolTip="{Binding Key}" />
                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding MissingSince}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Margin="12,0" Style="{StaticResource RecyclePill}" Visibility="{Binding InRecycleBin, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon FontSize="12" Symbol="Recycle20" />
                                                                <TextBlock Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="In Recycle Bin" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SizeText}" TextAlignment="Right" />
                                                        <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal">
                                                            <ui:Button Width="32" Height="32" Padding="0" Appearance="Transparent" AutomationProperties.Name="Deleted on purpose"
                                                                       Command="{Binding DeleteCommand}" Icon="{StaticResource DeleteIcon}" ToolTip="Deleted on purpose" />
                                                            <ui:Button Width="32" Height="32" Padding="0" Appearance="Transparent" AutomationProperties.Name="Keep on backup"
                                                                       Command="{Binding KeepCommand}" Icon="{StaticResource KeepIcon}" ToolTip="Keep on backup" />
                                                            <ui:Button Width="32" Height="32" Padding="0" Appearance="Transparent" AutomationProperties.Name="Decide later"
                                                                       Command="{Binding LaterCommand}" Icon="{StaticResource LaterIcon}" ToolTip="Decide later" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!--  Working  -->
        <ui:ProgressRing Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!--  Confirmation before anything leaves the backup  -->
        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="480" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ConfirmTitle}" />
                    <TextBlock Margin="0,12,0,24" Style="{StaticResource Body}" Text="{Binding ConfirmMessage}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button MinWidth="96" Command="{Binding CancelConfirmCommand}" Content="Cancel" IsCancel="True" />
                        <ui:Button Margin="8,0,0,0" Appearance="Danger" Command="{Binding ConfirmDeleteCommand}" Content="Send to Recycle Bin" Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
