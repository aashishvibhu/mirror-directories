<UserControl
    x:Class="DriveSync.App.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:DriveSync.Core.Model;assembly=DriveSync.Core"
    xmlns:vm="clr-namespace:DriveSync.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="36,16,36,24" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Drive unplugged: browsing still works  -->
            <Border Padding="16,10" CornerRadius="8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    Visibility="{Binding IsDriveConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource Body}" Text="The backup drive isn't connected. You can look through what's on it; plug it in to restore, offload or delete." />
            </Border>

            <!--  Search and filters  -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Width="300" AutomationProperties.Name="Search this backup" Icon="{ui:SymbolIcon Search24}" PlaceholderText="Search this backup"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button Command="{Binding ShowAllCommand}" Content="All">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource FilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAll}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Command="{Binding ShowOffloadedCommand}" Content="Offloaded" ToolTip="Files that are only on the backup, kept there on purpose">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource FilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOffloadedOnly}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Command="{Binding ShowMissingCommand}" Content="Missing from this PC" ToolTip="Files waiting for your decision">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource FilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissingOnly}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!--  Result of the last action  -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="8" Visibility="{Binding ResultMessage, Converter={StaticResource EmptyToCollapsed}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ResultMessage}" />
                        <ItemsControl ItemsSource="{Binding ResultProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextTrimming="None" TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Top" Appearance="Transparent" AutomationProperties.Name="Dismiss"
                               Command="{Binding DismissResultCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
                </Grid>
            </Border>

            <!--  Where you are, or what to do with the ticked items  -->
            <Grid Grid.Row="3" Margin="0,12,0,8" MinHeight="40">
                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Crumbs}" Focusable="False"
                              Visibility="{Binding SelectedCount, Converter={StaticResource ZeroToVisible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Crumb}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Padding="6,4" Appearance="Transparent" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding Key}" Content="{Binding Title}" />
                                <TextBlock Margin="2,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="›" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Padding="16,6" CornerRadius="8" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Visibility="{Binding SelectedCount, Converter={StaticResource CountToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Strong}" Text="{Binding SelectedCount, StringFormat={}{0:N0} selected}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Command="{Binding RestoreSelectedCommand}" Content="Restore" Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button Margin="6,0,0,0" Command="{Binding OffloadSelectedCommand}" Content="Free up space" Icon="{ui:SymbolIcon Archive24}"
                                       ToolTip="Keep on the backup, remove from this PC" />
                            <ui:Button Margin="6,0,0,0" Command="{Binding DeleteSelectedCommand}" Content="Delete everywhere" Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button Margin="6,0,0,0" Appearance="Transparent" Command="{Binding ClearSelectionCommand}" Content="Clear selection" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  The list  -->
            <Border Grid.Row="4" Padding="0" Style="{StaticResource Panel}">
                <Grid>
                    <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource PlainRows}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    <ui:SymbolIcon Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="20">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Document24" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Symbol" Value="Folder24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:Button Grid.Column="2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding OpenCommand}" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Name}" ToolTip="{Binding Key}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <Border Grid.Column="3" Margin="12,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static model:FileState.Archived}">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static model:FileState.Pending}">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
                                    </Border>
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding SizeText}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Modified}" TextAlignment="Right" />
                                    <StackPanel Grid.Column="6" Margin="12,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <ui:Button Width="32" Height="32" Padding="0" Appearance="Transparent" AutomationProperties.Name="Restore" Command="{Binding RestoreCommand}"
                                                   Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Restore to this PC"
                                                   IsEnabled="{Binding DataContext.IsDriveConnected, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <ui:Button Width="32" Height="32" Padding="0" Appearance="Transparent" AutomationProperties.Name="Older versions" Command="{Binding OpenCommand}"
                                                   Icon="{ui:SymbolIcon History24}" ToolTip="Older versions"
                                                   IsEnabled="{Binding DataContext.IsDriveConnected, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Width="32" Height="32" Padding="0" Appearance="Transparent" AutomationProperties.Name="Show on the drive" Command="{Binding ShowCommand}"
                                                   Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Show on the backup drive"
                                                   IsEnabled="{Binding DataContext.IsDriveConnected, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding EmptyText}"
                               Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
                    <Border Padding="16,12" VerticalAlignment="Top" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding LoadError}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  Working  -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing Width="40" Height="40" IsIndeterminate="True" />
            <TextBlock Margin="0,12,0,0" Style="{StaticResource Body}" Text="{Binding BusyText}" />
        </StackPanel>

        <!--  Older versions of one file  -->
        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560" MaxHeight="520" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding HistoryTitle, StringFormat=Older versions of {0}}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,12" Style="{StaticResource Secondary}" Text="{Binding HistoryNote}" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VersionRowViewModel}">
                                    <Border Padding="0,10" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding When, StringFormat=Replaced on {0}}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button Command="{Binding RestoreCommand}" Content="Restore this version" ToolTip="The current file on this PC is kept, renamed" />
                                                <ui:Button Margin="6,0,0,0" Appearance="Transparent" Command="{Binding RestoreAsCopyCommand}" Content="As a copy…" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ui:Button Grid.Row="3" MinWidth="96" Margin="0,16,0,0" HorizontalAlignment="Right" Command="{Binding CloseHistoryCommand}" Content="Close" IsCancel="True" />
                </Grid>
            </Border>
        </Grid>

        <!--  Confirmation before files leave the PC  -->
        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="500" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ConfirmTitle}" />
                    <TextBlock Margin="0,12,0,24" Style="{StaticResource Body}" Text="{Binding ConfirmMessage}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button MinWidth="96" Command="{Binding ConfirmNoCommand}" Content="Cancel" IsCancel="True" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding ConfirmYesCommand}" Content="{Binding ConfirmButton}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfirmIsDanger}" Value="True">
                                            <Setter Property="Appearance" Value="Danger" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
